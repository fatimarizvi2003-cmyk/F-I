<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Wedding Invitation — Fatima & Iftikhar</title>
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@300;400;500&family=La+Belle+Aurore&family=Montserrat:wght@200;300;400&display=swap" rel="stylesheet" />
  <style>
    :root {
      --ivory:#faf6ef;--cream:#f3ede2;--parchment:#e8dece;
      --gold:#b8862a;--gold-light:#d4a84b;--gold-dark:#8a6218;
      --charcoal:#2a2018;--brown-muted:#7a6548;--brown-light:#a8906e;
    }
    *{box-sizing:border-box;margin:0;padding:0}
    html{scroll-behavior:smooth}
    body{background-color:var(--ivory);color:var(--charcoal);font-family:'Montserrat',sans-serif;overflow-x:hidden}
    .font-cinzel{font-family:'Cinzel',serif}
    .font-handwritten{font-family:'La Belle Aurore',cursive}
    .glow-layer{position:fixed;inset:0;z-index:0;pointer-events:none;background:radial-gradient(ellipse 70% 50% at 50% 0%,rgba(184,134,42,.08) 0%,transparent 60%),radial-gradient(ellipse 50% 40% at 80% 80%,rgba(212,168,75,.06) 0%,transparent 50%)}
    .luxe-seal{width:128px;height:128px;background:radial-gradient(circle at 40% 35%,#f0e8d5 0%,#ddd0b5 100%);border:1.5px solid var(--gold);border-radius:50%;display:flex;justify-content:center;align-items:center;cursor:pointer;box-shadow:0 16px 40px rgba(184,134,42,.2),0 4px 12px rgba(0,0,0,.08),inset 0 0 20px rgba(184,134,42,.1);transition:transform .4s ease,box-shadow .4s ease;font-family:'Cinzel',serif;font-size:1.25rem;color:var(--gold-dark);letter-spacing:3px}
    .luxe-seal:hover{transform:scale(1.06);box-shadow:0 20px 50px rgba(184,134,42,.3),0 4px 16px rgba(0,0,0,.1),inset 0 0 24px rgba(184,134,42,.15)}
    .timeline-line{width:1px;height:80px;background:linear-gradient(to bottom,var(--gold),transparent);margin:2.5rem auto}
    .ornament-line{display:flex;align-items:center;gap:16px}
    .ornament-line::before,.ornament-line::after{content:"";flex:1;height:1px;background:linear-gradient(to right,transparent,var(--gold-light),transparent)}
    .section-divider{width:100%;display:flex;justify-content:center;padding:.5rem 0;opacity:.75}
    .section-divider-slim{display:flex;justify-content:center;padding:1rem 0;opacity:.6}
    .fade-up{opacity:0;transform:translateY(40px);transition:opacity 1.4s cubic-bezier(.16,1,.3,1),transform 1.4s cubic-bezier(.16,1,.3,1)}
    .fade-up.active{opacity:1;transform:translateY(0)}
    .petals-container{position:fixed;inset:0;pointer-events:none;z-index:5;overflow:hidden}
    .petal{position:absolute;top:-60px;border-radius:50% 5% 50% 5%;background:radial-gradient(circle at 35% 35%,#c0475a 0%,#8b1a2a 60%,#5c0f1a 100%);opacity:0;animation:petalFall linear infinite;transform-origin:center center}
    @keyframes petalFall{0%{opacity:0;top:-60px;transform:rotate(var(--rot,20deg)) translateX(0)}5%{opacity:.75}85%{opacity:.6}100%{opacity:0;top:110vh;transform:rotate(calc(var(--rot,20deg) + 200deg)) translateX(60px)}}
    #curtain{position:fixed;inset:0;z-index:50;display:flex;flex-direction:column;justify-content:center;align-items:center;background-color:var(--cream);background-image:radial-gradient(ellipse 80% 60% at 50% 40%,#f5ead4 0%,var(--cream) 70%);transition:opacity .9s ease,transform .9s ease}
    #curtain.fading{opacity:0;transform:scale(1.04);pointer-events:none}
    #curtain.gone{display:none}
    #main-content{display:none}
    #main-content.visible{display:block}
    main{position:relative;z-index:10;max-width:56rem;margin:0 auto;padding:0 2rem}
    .anim-block{opacity:0;transform:translateY(40px);transition:opacity 1.4s ease,transform 1.4s ease}
    .anim-block.show{opacity:1;transform:translateY(0)}
    .anim-block.dim{opacity:.4;transform:translateY(0)}
    @keyframes pulse{0%,100%{opacity:1}50%{opacity:.4}}
    .animate-pulse{animation:pulse 2s cubic-bezier(.4,0,.6,1) infinite}
    .hero-section{min-height:100vh;display:flex;flex-direction:column;justify-content:center;align-items:center;text-align:center;padding:7rem 0}
    .schedule-card{width:320px;padding:2.5rem 2rem;background-color:var(--cream);border:1px solid var(--parchment);box-shadow:0 4px 24px rgba(184,134,42,.08);border-radius:1rem}
    .schedule-row{display:flex;justify-content:space-between;align-items:center;padding:1.25rem 0;font-size:.875rem}
    .schedule-row+.schedule-row{border-top:1px solid var(--parchment)}
    .qr-card{display:flex;flex-direction:column;align-items:center;gap:1.5rem;border-radius:1rem;padding:2.5rem;background-color:var(--cream);border:1px solid var(--parchment);box-shadow:0 4px 24px rgba(184,134,42,.08);text-decoration:none;transition:box-shadow .3s ease}
    .qr-card:hover{box-shadow:0 8px 32px rgba(184,134,42,.15)}
    .qr-card img{border-radius:.5rem;border:3px solid var(--parchment);transition:transform .3s ease}
    .qr-card:hover img{transform:scale(1.05)}
    .directions-btn{display:inline-flex;align-items:center;gap:.5rem;padding:.5rem 1.5rem;border-radius:9999px;border:1px solid var(--gold);color:var(--gold-dark);font-family:'Cinzel',serif;font-size:.625rem;letter-spacing:.3em;text-transform:uppercase}
    .countdown-grid{display:flex;flex-wrap:wrap;gap:2.5rem;justify-content:center;align-items:center}
    .countdown-unit{text-align:center;min-width:70px}
    .countdown-digit{font-size:4.5rem;font-weight:300;letter-spacing:-.05em;display:block;font-variant-numeric:tabular-nums}
    @media(max-width:640px){.countdown-digit{font-size:3.5rem}.countdown-grid{gap:1.5rem}}
  </style>
</head>
<body>
<div class="glow-layer"></div>
<div class="petals-container" id="petals" aria-hidden="true"></div>

<!-- CURTAIN -->
<div id="curtain">
  <!-- Corner ornaments -->
  <svg style="position:absolute;width:110px;height:110px;opacity:.45;transform-origin:0 0;transform:translate(0,0) rotate(0);top:0;left:0" viewBox="0 0 110 110" fill="none"><path d="M8 8 Q32 8 32 32 Q32 8 58 8" stroke="var(--gold)" stroke-width="1" fill="none"/><path d="M8 8 Q8 32 32 32 Q8 32 8 58" stroke="var(--gold)" stroke-width="1" fill="none"/><circle cx="32" cy="32" r="3" fill="var(--gold)" opacity=".55"/><circle cx="58" cy="8" r="2" fill="var(--gold)" opacity=".35"/><circle cx="8" cy="58" r="2" fill="var(--gold)" opacity=".35"/><path d="M18 8 Q18 18 8 18" stroke="var(--gold)" stroke-width=".7" fill="none" opacity=".45"/><ellipse cx="45" cy="8" rx="4.5" ry="3" fill="var(--gold)" opacity=".18" transform="rotate(-20 45 8)"/><ellipse cx="8" cy="45" rx="3" ry="4.5" fill="var(--gold)" opacity=".18" transform="rotate(20 8 45)"/><path d="M18 32 Q25 25 32 18" stroke="var(--gold)" stroke-width=".6" fill="none" opacity=".3"/></svg>
  <svg style="position:absolute;width:110px;height:110px;opacity:.45;transform-origin:0 0;transform:translate(100vw,0) rotate(90deg);top:0;left:0" viewBox="0 0 110 110" fill="none"><path d="M8 8 Q32 8 32 32 Q32 8 58 8" stroke="var(--gold)" stroke-width="1" fill="none"/><path d="M8 8 Q8 32 32 32 Q8 32 8 58" stroke="var(--gold)" stroke-width="1" fill="none"/><circle cx="32" cy="32" r="3" fill="var(--gold)" opacity=".55"/><circle cx="58" cy="8" r="2" fill="var(--gold)" opacity=".35"/><circle cx="8" cy="58" r="2" fill="var(--gold)" opacity=".35"/><path d="M18 8 Q18 18 8 18" stroke="var(--gold)" stroke-width=".7" fill="none" opacity=".45"/><ellipse cx="45" cy="8" rx="4.5" ry="3" fill="var(--gold)" opacity=".18" transform="rotate(-20 45 8)"/><ellipse cx="8" cy="45" rx="3" ry="4.5" fill="var(--gold)" opacity=".18" transform="rotate(20 8 45)"/><path d="M18 32 Q25 25 32 18" stroke="var(--gold)" stroke-width=".6" fill="none" opacity=".3"/></svg>
  <svg style="position:absolute;width:110px;height:110px;opacity:.45;transform-origin:0 0;transform:translate(0,100vh) rotate(-90deg);top:0;left:0" viewBox="0 0 110 110" fill="none"><path d="M8 8 Q32 8 32 32 Q32 8 58 8" stroke="var(--gold)" stroke-width="1" fill="none"/><path d="M8 8 Q8 32 32 32 Q8 32 8 58" stroke="var(--gold)" stroke-width="1" fill="none"/><circle cx="32" cy="32" r="3" fill="var(--gold)" opacity=".55"/><circle cx="58" cy="8" r="2" fill="var(--gold)" opacity=".35"/><circle cx="8" cy="58" r="2" fill="var(--gold)" opacity=".35"/><path d="M18 8 Q18 18 8 18" stroke="var(--gold)" stroke-width=".7" fill="none" opacity=".45"/><ellipse cx="45" cy="8" rx="4.5" ry="3" fill="var(--gold)" opacity=".18" transform="rotate(-20 45 8)"/><ellipse cx="8" cy="45" rx="3" ry="4.5" fill="var(--gold)" opacity=".18" transform="rotate(20 8 45)"/><path d="M18 32 Q25 25 32 18" stroke="var(--gold)" stroke-width=".6" fill="none" opacity=".3"/></svg>
  <svg style="position:absolute;width:110px;height:110px;opacity:.45;transform-origin:0 0;transform:translate(100vw,100vh) rotate(180deg);top:0;left:0" viewBox="0 0 110 110" fill="none"><path d="M8 8 Q32 8 32 32 Q32 8 58 8" stroke="var(--gold)" stroke-width="1" fill="none"/><path d="M8 8 Q8 32 32 32 Q8 32 8 58" stroke="var(--gold)" stroke-width="1" fill="none"/><circle cx="32" cy="32" r="3" fill="var(--gold)" opacity=".55"/><circle cx="58" cy="8" r="2" fill="var(--gold)" opacity=".35"/><circle cx="8" cy="58" r="2" fill="var(--gold)" opacity=".35"/><path d="M18 8 Q18 18 8 18" stroke="var(--gold)" stroke-width=".7" fill="none" opacity=".45"/><ellipse cx="45" cy="8" rx="4.5" ry="3" fill="var(--gold)" opacity=".18" transform="rotate(-20 45 8)"/><ellipse cx="8" cy="45" rx="3" ry="4.5" fill="var(--gold)" opacity=".18" transform="rotate(20 8 45)"/><path d="M18 32 Q25 25 32 18" stroke="var(--gold)" stroke-width=".6" fill="none" opacity=".3"/></svg>
  <!-- Double border -->
  <div style="position:absolute;inset:16px;border:.5px solid rgba(184,134,42,.25);pointer-events:none"></div>
  <div style="position:absolute;inset:20px;border:.5px solid rgba(184,134,42,.12);pointer-events:none"></div>
  <!-- Arch above -->
  <svg style="position:absolute;top:18%;left:50%;transform:translateX(-50%);width:220px;height:70px;opacity:.38" viewBox="0 0 220 70" fill="none"><path d="M8 62 Q28 16 110 8 Q192 16 212 62" stroke="var(--gold)" stroke-width="1.1" fill="none"/><ellipse cx="22" cy="38" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(-25 22 38)"/><ellipse cx="48" cy="23" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(-16 48 23)"/><ellipse cx="76" cy="15" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(-7 76 15)"/><ellipse cx="110" cy="12" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(2 110 12)"/><ellipse cx="144" cy="15" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(11 144 15)"/><ellipse cx="172" cy="23" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(20 172 23)"/><ellipse cx="198" cy="38" rx="3.5" ry="5.5" fill="var(--gold)" opacity=".14" transform="rotate(38 198 38)"/></svg>
  <!-- Mirror arch below -->
  <svg style="position:absolute;bottom:16%;left:50%;transform:translateX(-50%) scaleY(-1);width:160px;height:50px;opacity:.25" viewBox="0 0 160 50" fill="none"><path d="M6 44 Q40 10 80 6 Q120 10 154 44" stroke="var(--gold)" stroke-width=".9" fill="none"/></svg>
  <!-- Label + seal + prompt -->
  <div class="ornament-line" style="width:12rem;margin-bottom:2.5rem;position:relative;z-index:2"><span class="font-cinzel" style="font-size:9px;letter-spacing:.3em;text-transform:uppercase;padding:0 .5rem;color:var(--gold)">Wedding Invitation</span></div>
  <button class="luxe-seal" id="sealBtn" aria-label="Open invitation" style="position:relative;z-index:2">I &amp; F</button>
  <p class="animate-pulse font-cinzel" style="text-transform:uppercase;margin-top:2rem;letter-spacing:.6em;font-size:9px;color:var(--brown-muted);position:relative;z-index:2">Click to Enter</p>
</div>

<!-- MAIN CONTENT -->
<div id="main-content">
<main>

  <!-- HERO -->
  <section class="hero-section">
    <div id="bismillah" class="anim-block" style="margin-bottom:3rem">
      <p style="font-size:2.5rem;font-weight:300;color:var(--gold-dark);line-height:1.7;margin-bottom:1rem">بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ</p>
      <p class="font-cinzel" style="font-size:10px;letter-spacing:.4em;text-transform:uppercase;color:var(--brown-muted)">In the name of Allah, the Most Beneficent and the Most Merciful</p>
    </div>
    <div id="names" class="anim-block">
      <div class="ornament-line" style="width:16rem;margin:0 auto 2.5rem"></div>
      <p class="font-cinzel" style="font-size:11px;letter-spacing:.5em;text-transform:uppercase;color:var(--gold);margin-bottom:2rem">The Honor of Your Presence is Requested</p>
      <p style="font-size:1.125rem;font-weight:300;color:var(--brown-muted);line-height:2;text-align:center;max-width:36rem;margin:0 auto 3rem">Mr. and Mrs. Sajjad cordially invite you to the<br>wedding ceremony of their beloved daughter</p>
      <h1 class="font-cinzel" style="font-size:clamp(1.5rem,5vw,3rem);font-weight:500;color:var(--charcoal);letter-spacing:.1em;text-align:center;margin-bottom:1.5rem">SYEDA FATIMA SUGHRA</h1>
      <p class="font-handwritten" style="font-size:3rem;color:var(--gold);text-align:center;margin-bottom:1.5rem">with</p>
      <h1 class="font-cinzel" style="font-size:clamp(1.5rem,5vw,3rem);font-weight:500;color:var(--charcoal);letter-spacing:.1em;text-align:center;margin-bottom:.75rem">SYED IFTIKHAR HUSSAIN</h1>
      <p class="font-cinzel" style="font-size:11px;letter-spacing:.3em;text-transform:uppercase;color:var(--brown-muted);text-align:center;margin-bottom:3rem">S/o Syed Arshad Qasim</p>
      <div class="ornament-line" style="width:16rem;margin:0 auto 2rem"></div>
      <p class="animate-pulse font-cinzel" style="font-size:9px;letter-spacing:.5em;text-transform:uppercase;color:var(--brown-light);text-align:center">SCROLL</p>
    </div>
  </section>

  <!-- DIVIDER -->
  <div class="section-divider" aria-hidden="true"><svg width="100%" height="60" viewBox="0 0 600 60" preserveAspectRatio="xMidYMid meet" fill="none"><line x1="0" y1="30" x2="218" y2="30" stroke="url(#d1l)" stroke-width=".7"/><polygon points="228,30 234,26 240,30 234,34" fill="none" stroke="var(--gold)" stroke-width=".7" opacity=".55"/><circle cx="300" cy="30" r="12" fill="none" stroke="var(--gold)" stroke-width=".8" opacity=".6"/><circle cx="300" cy="30" r="7" fill="none" stroke="var(--gold)" stroke-width=".5" opacity=".4"/><circle cx="300" cy="30" r="2.5" fill="var(--gold)" opacity=".65"/><line x1="300" y1="16" x2="300" y2="44" stroke="var(--gold)" stroke-width=".5" opacity=".3"/><line x1="286" y1="30" x2="314" y2="30" stroke="var(--gold)" stroke-width=".5" opacity=".3"/><circle cx="280" cy="30" r="1.8" fill="var(--gold)" opacity=".4"/><circle cx="320" cy="30" r="1.8" fill="var(--gold)" opacity=".4"/><polygon points="360,30 366,26 372,30 366,34" fill="none" stroke="var(--gold)" stroke-width=".7" opacity=".55"/><line x1="382" y1="30" x2="600" y2="30" stroke="url(#d1r)" stroke-width=".7"/><defs><linearGradient id="d1l" x1="0" y1="0" x2="218" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity="0"/><stop offset="100%" stop-color="var(--gold)" stop-opacity=".55"/></linearGradient><linearGradient id="d1r" x1="382" y1="0" x2="600" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity=".55"/><stop offset="100%" stop-color="var(--gold)" stop-opacity="0"/></linearGradient></defs></svg></div>

  <!-- VERSES -->
  <section class="fade-up" style="display:flex;flex-direction:column;align-items:center;text-align:center;padding:4rem 1rem">
    <p style="font-size:1.25rem;font-weight:300;font-style:italic;color:var(--brown-muted);line-height:1.625;max-width:42rem">"And We created you in pairs."</p>
    <div class="timeline-line"></div>
    <p style="font-size:1.25rem;font-weight:300;font-style:italic;color:var(--brown-muted);line-height:1.625;max-width:42rem">"And He put between you affection and mercy."</p>
  </section>

  <!-- DIVIDER -->
  <div class="section-divider" aria-hidden="true"><svg width="100%" height="60" viewBox="0 0 600 60" preserveAspectRatio="xMidYMid meet" fill="none"><line x1="0" y1="30" x2="218" y2="30" stroke="url(#d2l)" stroke-width=".7"/><polygon points="228,30 234,26 240,30 234,34" fill="none" stroke="var(--gold)" stroke-width=".7" opacity=".55"/><circle cx="300" cy="30" r="12" fill="none" stroke="var(--gold)" stroke-width=".8" opacity=".6"/><circle cx="300" cy="30" r="7" fill="none" stroke="var(--gold)" stroke-width=".5" opacity=".4"/><circle cx="300" cy="30" r="2.5" fill="var(--gold)" opacity=".65"/><line x1="300" y1="16" x2="300" y2="44" stroke="var(--gold)" stroke-width=".5" opacity=".3"/><line x1="286" y1="30" x2="314" y2="30" stroke="var(--gold)" stroke-width=".5" opacity=".3"/><circle cx="280" cy="30" r="1.8" fill="var(--gold)" opacity=".4"/><circle cx="320" cy="30" r="1.8" fill="var(--gold)" opacity=".4"/><polygon points="360,30 366,26 372,30 366,34" fill="none" stroke="var(--gold)" stroke-width=".7" opacity=".55"/><line x1="382" y1="30" x2="600" y2="30" stroke="url(#d2r)" stroke-width=".7"/><defs><linearGradient id="d2l" x1="0" y1="0" x2="218" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity="0"/><stop offset="100%" stop-color="var(--gold)" stop-opacity=".55"/></linearGradient><linearGradient id="d2r" x1="382" y1="0" x2="600" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity=".55"/><stop offset="100%" stop-color="var(--gold)" stop-opacity="0"/></linearGradient></defs></svg></div>

  <!-- VENUE -->
  <section class="fade-up" style="text-align:center;padding:4rem 0">
    <div class="ornament-line" style="width:12rem;margin:0 auto 2.5rem"></div>
    <p class="font-cinzel" style="font-size:10px;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);margin-bottom:1.25rem">The Gathering</p>
    <h2 class="font-cinzel" style="font-size:clamp(2rem,8vw,3.75rem);color:var(--charcoal);letter-spacing:.05em;margin-bottom:1.5rem;line-height:1.25">Himalaya Banquet</h2>
    <p class="font-cinzel" style="font-size:1.5rem;letter-spacing:.1em;color:var(--gold-dark);margin-bottom:.75rem">30 AUGUST 2026</p>
    <p style="font-size:.875rem;text-transform:uppercase;letter-spacing:.1em;color:var(--brown-light)">Sunday Evening</p>
    <div class="ornament-line" style="width:12rem;margin:2.5rem auto 0"></div>
  </section>

  <!-- SLIM DIVIDER -->
  <div class="section-divider-slim" aria-hidden="true"><svg width="320" height="28" viewBox="0 0 320 28" fill="none"><line x1="0" y1="14" x2="130" y2="14" stroke="url(#ds1)" stroke-width=".8"/><circle cx="160" cy="14" r="3.5" fill="none" stroke="var(--gold)" stroke-width=".9"/><circle cx="160" cy="14" r="1.5" fill="var(--gold)" opacity=".7"/><circle cx="144" cy="14" r="1.8" fill="var(--gold)" opacity=".35"/><circle cx="176" cy="14" r="1.8" fill="var(--gold)" opacity=".35"/><line x1="190" y1="14" x2="320" y2="14" stroke="url(#dsr1)" stroke-width=".8"/><defs><linearGradient id="ds1" x1="0" y1="0" x2="130" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity="0"/><stop offset="100%" stop-color="var(--gold)" stop-opacity=".5"/></linearGradient><linearGradient id="dsr1" x1="190" y1="0" x2="320" y2="0" gradientUnits="userSpaceOnUse"><stop offset="0%" stop-color="var(--gold)" stop-opacity=".5"/><stop offset="100%" stop-color="var(--gold)" stop-opacity="0"/></linearGradient></defs></svg></div>

  <!-- SCHEDULE -->
  <section class="fade-up" style="display:flex;justify-content:center;padding:3rem 0">
    <div class="schedule-card">
      <p class="font-cinzel" style="font-size:10px;letter-spacing:.4em;text-transform:uppercase;color:var(--gold);text-align:center;margin-bottom:2rem">Celebration Schedule</p>
      <div class="schedule-row" style="color:var(--brown-muted);font-weight:300"><span>Barat Arrival</span><span class="font-cinzel" style="color:var(--gold-dark)">08:00 PM</span></div>
      <div class="schedule-row" style="color:var(--charcoal);font-weight:500"><span>Nikah Ceremony</span><span class="font-cinzel" style="color:var(--gold-dark)">09:00 PM</span></div>
      <div class="schedule-row" style="color:var(--brown-muted);font-weight:300"><span>Dinner</span><span class="font-cinzel" style="color:var(--gold-dark)">10:00 PM</span></div>
      <div class="schedule-row" style="color:var(--brown-muted);font-weight:300"><span>Rukhsati</span><span class="font-cinzel" style="color:var(--gold-dark)">11:00 PM</span></div>
    </div>
  </section>


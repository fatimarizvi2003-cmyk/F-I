<script>
  const PETALS=[{left:5,delay:0,dur:9,size:18,rot:20},{left:12,delay:1.5,dur:11,size:14,rot:-30},{left:22,delay:3,dur:8,size:20,rot:45},{left:33,delay:.5,dur:13,size:12,rot:-15},{left:42,delay:2,dur:10,size:16,rot:60},{left:55,delay:4,dur:9,size:22,rot:-40},{left:63,delay:1,dur:12,size:15,rot:25},{left:72,delay:3.5,dur:8,size:18,rot:-55},{left:81,delay:.8,dur:11,size:13,rot:35},{left:90,delay:2.5,dur:10,size:20,rot:-20},{left:8,delay:5,dur:14,size:11,rot:50},{left:48,delay:6,dur:9,size:17,rot:-45},{left:68,delay:4.5,dur:12,size:14,rot:30},{left:85,delay:7,dur:10,size:19,rot:-25},{left:28,delay:6.5,dur:11,size:16,rot:55}];
  function spawnPetals(){const c=document.getElementById('petals');PETALS.forEach(p=>{const el=document.createElement('div');el.className='petal';el.style.cssText=`left:${p.left}%;animation-delay:${p.delay}s;animation-duration:${p.dur}s;width:${p.size}px;height:${p.size*1.4}px;--rot:${p.rot}deg`;c.appendChild(el)});}
  const obs=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting)e.target.classList.add('active')}),{threshold:.1});
  function initFades(){document.querySelectorAll('.fade-up').forEach(el=>obs.observe(el));}
  document.getElementById('sealBtn').addEventListener('click',function(){
    const curtain=document.getElementById('curtain'),main=document.getElementById('main-content');
    curtain.classList.add('fading');
    setTimeout(()=>{
      curtain.classList.add('gone');main.classList.add('visible');
      spawnPetals();initFades();
      const b=document.getElementById('bismillah');
      setTimeout(()=>b.classList.add('show'),100);
      setTimeout(()=>{b.classList.remove('show');b.classList.add('dim');},2200);
      setTimeout(()=>document.getElementById('names').classList.add('show'),2400);
    },900);
  });
  const W=new Date('2026-08-30T20:00:00');
  function pad(n){return String(n).padStart(2,'0');}
  function tick(){const d=W-Date.now();if(d<=0){['days','hours','minutes','seconds'].forEach(k=>document.getElementById('cd-'+k).textContent='00');return;}document.getElementById('cd-days').textContent=pad(Math.floor(d/86400000));document.getElementById('cd-hours').textContent=pad(Math.floor((d%86400000)/3600000));document.getElementById('cd-minutes').textContent=pad(Math.floor((d%3600000)/60000));document.getElementById('cd-seconds').textContent=pad(Math.floor((d%60000)/1000));}
  tick();setInterval(tick,1000);
</script>
